{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:automergeDaily"
  ],
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "Kotlin & Compose Multiplatform dependencies",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/",
        "/^org\\.jetbrains\\.compose/",
        "/^io\\.coil-kt\\.coil3/",
        "/^io\\.github\\.vinceglb/"
      ]
    },
    {
      "groupName": "Detekt static analysis tools",
      "matchPackageNames": [
        "/^dev\\.detekt/",
        "/^io\\.nlopez\\.compose\\.rules/"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions workflow dependencies"
    }
  ],
  "labels": [
    ":arrow_up: dependencies",
    ":robot: renovate"
  ],
  "dependencyDashboardLabels": [
    ":robot: renovate"
  ],
  "recreateWhen": "never"
}
